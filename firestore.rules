rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: users/{userId}/sync
// Document ID: {docId}
// Fields:
//   - stateJson: string (required, max 1,000,000 chars) - Serialized application state JSON
//   - updatedAt: number (required) - Client sync timestamp in epoch milliseconds
//   - updatedBy: string (required, max 128 chars) - Identifier of the client/device/user that wrote the sync state
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the target userId path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate that the document contains all required fields
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validate sync document schema, types, and size bounds
    function isValidSyncDoc(data) {
      return hasOnlyAllowedFields(['stateJson', 'updatedAt', 'updatedBy']) &&
             hasRequiredFields(['stateJson', 'updatedAt', 'updatedBy']) &&
             data.stateJson is string &&
             data.stateJson.size() <= 1000000 &&
             data.updatedAt is number &&
             data.updatedBy is string &&
             data.updatedBy.size() <= 128;
    }

    // ===============================================================
    // Default Deny
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // User-scoped sync documents: users/{userId}/sync/{docId}
    match /users/{userId}/sync/{docId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidSyncDoc(request.resource.data);
      allow update: if isOwner(userId) && isValidSyncDoc(request.resource.data);
      allow delete: if isOwner(userId);
    }
  }
}
